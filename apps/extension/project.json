{
  "name": "extension",
  "root": "apps/extension",
  "sourceRoot": "apps/extension/src",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "ng build extension",
        "cwd": "apps/extension"
      },
      "outputs": ["{projectRoot}/dist"]
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "ng test extension --watch=false",
        "cwd": "apps/extension"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "ng lint extension",
        "cwd": "apps/extension"
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "ng serve extension",
        "cwd": "apps/extension"
      },
      "cache": false
    }
  }
}