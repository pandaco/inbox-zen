{
  "name": "extension",
  "version": "0.2.3",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "prebuild": "node scripts/generate-manifest.mjs",
    "build": "ng build && npm run build:workers",
    "build:workers": "npx esbuild src/content-script/content-script.ts --bundle --outfile=dist/content-script.js --platform=browser --target=chrome120 --format=iife --tsconfig=tsconfig.workers.json && npx esbuild src/background/background.ts --bundle --outfile=dist/background.js --platform=browser --target=chrome120 --format=iife --tsconfig=tsconfig.workers.json",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "ng lint"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "packageManager": "npm@11.8.0",
  "dependencies": {
    "@angular/common": "^22.0.5",
    "@angular/compiler": "^22.0.5",
    "@angular/core": "^22.0.5",
    "@angular/forms": "^22.0.5",
    "@angular/platform-browser": "^22.0.5",
    "@angular/router": "^22.0.5",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular-eslint/builder": "22.0.0",
    "@angular/build": "^22.0.5",
    "@angular/cli": "^22.0.5",
    "@angular/compiler-cli": "^22.0.5",
    "@eslint/js": "^10.0.1",
    "@types/chrome": "^0.1.39",
    "angular-eslint": "22.0.0",
    "dotenv": "^16.4.7",
    "eslint": "^10.0.3",
    "jsdom": "^27.1.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.63.0",
    "vitest": "^4.0.8"
  }
}
