{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "defaultBase": "main",
  "tasksRunnerOptions": {
    "default": {
      "runner": "nx/tasks-runners/default",
      "options": {
        "cacheableOperations": [
          "build",
          "test",
          "lint",
          "e2e"
        ]
      }
    }
  },
  "targetDefaults": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "{projectRoot}/dist"
      ]
    },
    "test": {
      "dependsOn": [
        "^build"
      ]
    },
    "lint": {},
    "@nx/eslint:lint": {
      "cache": true,
      "inputs": [
        "default",
        "{workspaceRoot}/.eslintrc.json",
        "{workspaceRoot}/.eslintignore",
        "{workspaceRoot}/eslint.config.mjs"
      ]
    }
  },
  "release": {
    "projects": ["inbox-zen", "extension"],
    "version": {
      "generatorOptions": {
        "fallbackCurrentVersionResolver": "disk"
      },
      "conventionalCommits": true
    },
    "tagFormat": "v{version}",
    "changelog": {
      "workspaceChangelog": {
        "renderOptions": {
          "authors": false
        }
      },
      "projectChangelogs": {
        "renderOptions": {
          "authors": false
        }
      }
    }
  }
}
